{
  "name": "perzian",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "app": "npm run build --workspace=@perzian/web && electron apps/desktop",
    "app:dev": "npm run dev --workspace=@perzian/web & PERZIAN_WEB_URL=http://localhost:4318 electron apps/desktop",
    "dev": "npm run dev --workspace=@perzian/daemon & npm run dev --workspace=@perzian/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "e2e": "tsx scripts/e2e.ts",
    "test": "tsx --test packages/*/test/*.test.ts apps/*/test/*.test.ts",
    "bundle": "node scripts/build-bundle.mjs",
    "dist": "node scripts/build-app.mjs",
    "site": "node scripts/build-site.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "author": "Aadit Singal",
  "license": "MIT",
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "fsevents": true
  }
}
